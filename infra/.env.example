# Vault DB — identity plane. Separate credentials from Core, on purpose (LAW 1).
VAULT_DB_USER=vault_app
VAULT_DB_PASSWORD=vault_dev_pw
VAULT_DB_NAME=vault_db
VAULT_DB_PORT=5433
VAULT_DATABASE_URL=postgres://vault_app:vault_dev_pw@localhost:5433/vault_db

# Core DB — data plane. Never share credentials with Vault.
CORE_DB_USER=core_app
CORE_DB_PASSWORD=core_dev_pw
CORE_DB_NAME=core_db
CORE_DB_PORT=5434
CORE_DATABASE_URL=postgres://core_app:core_dev_pw@localhost:5434/core_db

# Vault service — identity plane (Phase 1). Lives only in Vault's process/KMS.
# Dev placeholder only — production must source this from a real KMS, never a .env file.
ALIAS_PEPPER=dev-only-pepper-change-me
VAULT_PORT=3001

# Delivery-address + UPI-ID encryption (Phase 4 §7 / Phase 6 §5A) — reversible
# by design, unlike the alias. Dev placeholder only — production must source
# this from a real KMS.
VAULT_SECRET_KEY=dev-only-vault-secret-change-me

# Core API — data plane (Phase 1).
API_PORT=3000
# Vault is never internet-facing — only Core calls it, over this internal URL.
VAULT_INTERNAL_URL=http://localhost:3001

# Ops/Supplier Portal (Phase 3) — hardcoded via `next dev/start -p 3002` in
# apps/portal/package.json, not read from this var directly (Next has no
# native PORTAL_PORT-style env hook), but recorded here so every port in the
# stack is assigned in one place: vault=3001, api=3000, portal=3002.

# Shared between Vault (signs) and Core (verifies) — Vault is the sole issuer.
# Dev placeholder only — rotate per environment.
JWT_SECRET=dev-only-jwt-secret-change-me

# Redis + BullMQ — aggregation, token-rate fixing (Phase 3), matching (Phase 4+).
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Portal (Phase 3) — §10: a separate, restricted core_db role that can SELECT
# demand_aggregates/token_rate/zones/categories ONLY. No grant on members,
# responses, snaps, consents, or token_ledger exists for this role — enforced
# at the database, not just by which queries the portal code happens to write.
CORE_PORTAL_DB_USER=core_portal
CORE_PORTAL_DB_PASSWORD=core_portal_dev_pw
CORE_PORTAL_DATABASE_URL=postgres://core_portal:core_portal_dev_pw@localhost:5434/core_db

# Portal → Core API, for the Area Intelligence page (SPEC.md §20) — every read
# and write there goes through this, never a new grant on the restricted
# CORE_PORTAL_DATABASE_URL role above.
CORE_API_INTERNAL_URL=http://localhost:3000

# Area intelligence question engine (Phase 8 / SPEC.md §20) — OPTIONAL. Both
# empty by default; the feature fails loudly with a clear error if used
# without them, rather than faking a response. See README's "Area
# intelligence setup" section for how to obtain each one.
#
# console.anthropic.com → Get API Key. Used to build zone_understanding from
# ingested documents and to draft document_grounded question variants.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=

# Google Cloud Console → IAM & Admin → Service Accounts → create one → Keys →
# Add key (JSON) → paste the ENTIRE downloaded JSON file content as a single
# line here. Then share each target Drive folder with this key's
# `client_email` (read-only) — the app never gets broader Drive access than
# the specific folders you explicitly share.
GOOGLE_SERVICE_ACCOUNT_KEY=
