# Vault DB — identity plane. Separate credentials from Core, on purpose (LAW 1).
VAULT_DB_USER=vault_app
VAULT_DB_PASSWORD=vault_dev_pw
VAULT_DB_NAME=vault_db
VAULT_DB_PORT=5433
VAULT_DATABASE_URL=postgres://vault_app:vault_dev_pw@localhost:5433/vault_db

# Core DB — data plane. Never share credentials with Vault.
CORE_DB_USER=core_app
CORE_DB_PASSWORD=core_dev_pw
CORE_DB_NAME=core_db
CORE_DB_PORT=5434
CORE_DATABASE_URL=postgres://core_app:core_dev_pw@localhost:5434/core_db

# Vault service — identity plane (Phase 1). Lives only in Vault's process/KMS.
# Dev placeholder only — production must source this from a real KMS, never a .env file.
ALIAS_PEPPER=dev-only-pepper-change-me
VAULT_PORT=3001

# Delivery-address encryption (Phase 4, §7) — reversible by design, unlike the
# alias. Dev placeholder only — production must source this from a real KMS.
ADDRESS_ENCRYPTION_KEY=dev-only-address-key-change-me

# Core API — data plane (Phase 1).
API_PORT=3000
# Vault is never internet-facing — only Core calls it, over this internal URL.
VAULT_INTERNAL_URL=http://localhost:3001

# Shared between Vault (signs) and Core (verifies) — Vault is the sole issuer.
# Dev placeholder only — rotate per environment.
JWT_SECRET=dev-only-jwt-secret-change-me

# Redis + BullMQ — aggregation, token-rate fixing (Phase 3), matching (Phase 4+).
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Portal (Phase 3) — §10: a separate, restricted core_db role that can SELECT
# demand_aggregates/token_rate/zones/categories ONLY. No grant on members,
# responses, snaps, consents, or token_ledger exists for this role — enforced
# at the database, not just by which queries the portal code happens to write.
CORE_PORTAL_DB_USER=core_portal
CORE_PORTAL_DB_PASSWORD=core_portal_dev_pw
CORE_PORTAL_DATABASE_URL=postgres://core_portal:core_portal_dev_pw@localhost:5434/core_db
