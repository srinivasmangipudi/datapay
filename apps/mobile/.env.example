# Core API base URL (apps/mobile/src/config.ts). EXPO_PUBLIC_ prefix makes
# this available to the client bundle — Expo loads .env files at the project
# root automatically, no extra config needed (SDK 49+).
#
# The right value depends on where the app is actually running relative to
# the API process on your machine:
#   - iOS Simulator (same Mac as the API):        http://localhost:3000
#   - Android Emulator (same Mac as the API):     http://10.0.2.2:3000
#   - Physical device via Expo Go (same Wi-Fi):   http://<your-machine-LAN-IP>:3000
#
# Copy this file to .env and adjust for your setup:
#   cp .env.example .env
EXPO_PUBLIC_API_URL=http://localhost:3000
