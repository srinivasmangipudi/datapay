<!--
  Notification small icon: the DataPay mark as a flat white silhouette.

  Android renders the small icon as a MASK — it keeps alpha and discards every
  colour. With no default_notification_icon declared, FCM falls back to the
  LAUNCHER icon, whose opaque square flattens into an unrecognisable blob.

  The ring is an even-odd path (outer circle minus inner) rather than a stroke,
  so it cannot hairline away on a low-density screen. Both circles are drawn as
  TWO arcs each: a single arc returning to its own start point is ambiguous and
  Android fills it as a solid disc — which is exactly how the first version
  shipped, and it read as a green tomato.

  Rendered at 24px and compared against alternatives before building. A bold
  letter "D" was more legible still, but introduces a symbol the brand does not
  otherwise use — this keeps the mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Ring: outer circle with the inner punched out by evenOdd. Thicker
         than the brand mark's, because a 24dp status bar eats fine strokes. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M1,12 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0 M5,12 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0" />

    <!-- A solid dot, not the mark's rounded square: at this size a square with
         a gap around it reads as a smudge, where concentric circles stay
         legible. Three bold elements, no fine detail. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,8.6 a3.4,3.4 0 1,0 0,6.8 a3.4,3.4 0 1,0 0,-6.8 Z" />
</vector>
